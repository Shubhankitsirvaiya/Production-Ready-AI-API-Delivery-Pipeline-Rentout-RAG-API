# Production credentials stay local in .env.prod and are never committed.
OPENAI_API_KEY=your_production_openai_api_key

# Keep tracing off until exporting production trace data is approved.
LANGSMITH_TRACING=false

# Keep production trace credentials separate from dev and test.
LANGSMITH_API_KEY=

# Production traces use a dedicated project for access and retention control.
LANGSMITH_PROJECT=rentout-project-12-prod

# Default US endpoint; replace it only when your account uses another region.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required only for an organization-scoped key with multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Add these only when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=
