# Development credentials stay local in .env.dev and are never committed.
OPENAI_API_KEY=your_development_openai_api_key

# Keep tracing off until exporting application trace data is approved.
LANGSMITH_TRACING=false

# Development LangSmith credential; leave blank while tracing is disabled.
LANGSMITH_API_KEY=

# Keep development traces separate from test and production traces.
LANGSMITH_PROJECT=rentout-project-12-dev

# Default US endpoint; replace it only when your account uses another region.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required only for an organization-scoped key with multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Add these only when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=
