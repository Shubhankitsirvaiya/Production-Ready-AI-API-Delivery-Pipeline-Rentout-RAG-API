# Local virtual environments.
.venv/
venv/

# Python bytecode and cache directories.
__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Local secrets should never be committed.
.env
.env.*

# Keep the safe example env file committed.
!.env.example
!.env.dev.example
!.env.test.example
!.env.prod.example

# Local/generated artifacts.
artifacts/
qa/
htmlcov/
.coverage
.deepeval/

# Local vector database experiments.
chroma/
chroma_db/
.chroma/
*.sqlite3
*.db

# Runtime audit logs and generated vector stores.
app/data/audit_logs/*.jsonl
app/data/vector_store/*.json

# Presentation sources and their slide-only image assets stay local.
slides/
icons/

# Microsoft Word creates temporary lock files beside open documents.
~$*.docx

# Real Kubernetes and Argo CD Secret manifests must remain local.
k8s/**/secrets.yaml
k8s/**/registry-secret.yaml
argocd/repository-secret.yaml
