# Test credentials stay local in .env.test and are never committed.
OPENAI_API_KEY=your_test_openai_api_key

# Keep tracing off until exporting test trace data is approved.
LANGSMITH_TRACING=false

# Use a non-production LangSmith API key when tracing is approved.
LANGSMITH_API_KEY=

# Test traces use their own project for clean filtering and retention decisions.
LANGSMITH_PROJECT=rentout-project-12-test

# Default US endpoint; replace it only when your account uses another region.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required only for an organization-scoped key with multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Add these only when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=
