# Secrets
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI models
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Application metadata
APP_NAME=RentOut RAG Chatbot
APP_VERSION=0.1.0

# Local storage
DATA_DIR=app/data
PROMPT_DIR=app/data/prompts
AUDIT_LOG_DIR=app/data/audit_logs
VECTOR_STORE_PATH=app/data/vector_store/rentout_vectors.json

# Retrieval and chunking
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150