# Private OpenAI API key used for embeddings and answer generation.
OPENAI_API_KEY=your_openai_api_key_here

# Chat model used by app/rag/generator.py for final answers.
OPENAI_CHAT_MODEL=gpt-5

# Embedding model used by ingestion and retrieval.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Trace export is off by default because traces may contain user and document content.
LANGSMITH_TRACING=false

# Add a LangSmith API key only after approving trace-data export.
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Group local traces under this project if tracing is explicitly enabled.
LANGSMITH_PROJECT=rentout-local-development

# Default LangSmith US endpoint; use the endpoint assigned to your account region.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Human-readable app name returned by GET /version.
APP_NAME=RentOut RAG Chatbot

# Local app version; Docker builds override this with commit SHA or release tag.
APP_VERSION=0.1.0

# Identifies local, dev, test, or prod traffic in status responses.
DEPLOYMENT_ENVIRONMENT=local

# Kubernetes replaces these values through the Downward API.
POD_NAME=local-process
POD_NAMESPACE=local
NODE_NAME=local-machine

# Minimum application log severity.
LOG_LEVEL=INFO

# Root local data directory.
DATA_DIR=app/data

# Prompt registry directory.
PROMPT_DIR=app/data/prompts

# Audit log output directory.
AUDIT_LOG_DIR=app/data/audit_logs

# Local JSON vector store path.
VECTOR_STORE_PATH=app/data/vector_store/rentout_vectors.json

# Number of retrieved chunks sent to answer generation.
TOP_K=5

# Approximate character size per text chunk.
CHUNK_SIZE=900

# Characters repeated between neighboring chunks.
CHUNK_OVERLAP=150

# Optional credentials for pulling a private GHCR package into Kubernetes.
GHCR_USERNAME=your_github_username
GHCR_TOKEN=your_github_token_with_read_packages
