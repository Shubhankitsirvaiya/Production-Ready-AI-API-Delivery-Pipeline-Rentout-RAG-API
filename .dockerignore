# Exclude git internals from the Docker build context.
.git

# Exclude GitHub workflow files because the running container does not need them.
.github

# Exclude git ignore rules from the image.
.gitignore

# Exclude local secrets from the image.
.env
.env.*

# Keep the safe sample env file in git, but not needed in Docker image.
.env.example

# Exclude local virtual environments.
.venv
venv

# Exclude Python bytecode/cache folders.
__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Exclude build outputs.
build/
dist/

# Exclude tests from runtime image.
tests/

# Exclude local reports/evaluation outputs.
htmlcov/
.coverage
.deepeval/

# Exclude classroom/demo presentation assets from runtime image.
slides/
icons/
README.md

# Exclude generated runtime logs and vector data; mount/regenerate these instead.
app/data/audit_logs/*.jsonl
app/data/vector_store/*.json