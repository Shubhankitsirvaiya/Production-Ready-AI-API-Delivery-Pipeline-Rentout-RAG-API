# Git and GitHub metadata are not needed inside Docker builds.
.git
.github
.gitignore

# Local secrets and environment files must never be copied into the image.
.env
.env.*

# Local virtual environments and Python build/cache output.
.venv
venv
__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Test, coverage, and local evaluation artifacts are not runtime dependencies.
tests/
htmlcov/
.coverage
.deepeval/

# Presentation/demo assets are not required by the API container.
slides/
icons/
README.md

# Runtime/generated application data should be mounted or regenerated, not baked into the image.
app/data/audit_logs/*.jsonl
app/data/vector_store/*.json